# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=numenor_security
DB_USER=postgres
DB_PASSWORD=

# Application Configuration
NODE_ENV=development
PORT=3000

# Security (for production)
JWT_SECRET=your-super-secret-jwt-key-here
SESSION_SECRET=your-super-secret-session-key-here

# Email Configuration (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Numenor Security <youremail@numenorsecurity.com>
TOKEN_SECRET=emailtoken
PROCESSED_EMAIL_RETENTION_HOURS=24

VITE_GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/gmail/callback
FRONTEND_URL=http://localhost:3000

# =============================================================================
# WHOIS API CONFIGURATION
# =============================================================================
# Get free API keys from:
# 1. whoisjson.com - https://whoisjson.com/ (1000 free requests/month)
# 2. whoisxmlapi.com - https://whoisxmlapi.com/ (1000 free requests/month)
WHOIS_JSON_API_KEY=your-whoisjson-api-key
WHOIS_XML_API_KEY=your-whoisxml-api-key