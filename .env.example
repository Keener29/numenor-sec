# Docker Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# These are automatically configured for Docker - no changes needed
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=
API_PORT=
FRONTEND_PORT=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate strong secrets for production:
# JWT_SECRET: Use a long, random string (32+ characters)
# TOKEN_SECRET: Use a 64-character hex string
JWT_SECRET=
TOKEN_SECRET=

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL FOR TESTING)
# =============================================================================
# For testing, you can use the defaults. For production, configure your SMTP:
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PROCESSED_EMAIL_RETENTION_HOURS=

# =============================================================================
# REDIS CONFIGURATION (OPTIONAL)
# =============================================================================
# These are automatically configured for Docker - no changes needed
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# LOGIN (MSAL)
VITE_MS_LOGIN_CLIENT_ID=
VITE_MS_LOGIN_CLIENT_ID_PROD=
VITE_MS_LOGIN_REDIRECT_URI=
VITE_MS_LOGIN_REDIRECT_URI_PROD=

# MS CONNECTOR
VITE_AZURE_CLIENT_ID_PROD=
AZURE_CLIENT_SECRET_PROD=
VITE_AZURE_TENANT_ID_PROD=
AZURE_REDIRECT_URI_PROD=
VITE_AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
VITE_AZURE_TENANT_ID=
AZURE_REDIRECT_URI=

MICROSOFT_SUBSCRIPTION_EXPIRATION_HOURS=72
MICROSOFT_SUBSCRIPTION_RENEWAL_THRESHOLD_HOURS=24

FRONTEND_URL=
VITE_API_URL=
PUBSUB_WEBHOOK_URL=

GOOGLE_CLIENT_ID_PROD=
VITE_GOOGLE_CLIENT_ID_PROD=
GOOGLE_CLIENT_SECRET_PROD=
GOOGLE_REDIRECT_URI_PROD=

GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Optional (with defaults)
GMAIL_PUBSUB_TOPIC=gmail-notifications
GMAIL_PUBSUB_SUBSCRIPTION=gmail-notify-sub

# =============================================================================
# WHOIS API CONFIGURATION
# =============================================================================
# Get free API keys from:
# 1. whoisjson.com - https://whoisjson.com/ (1000 free requests/month)
# 2. whoisxmlapi.com - https://whoisxmlapi.com/ (1000 free requests/month)
WHOIS_JSON_API_KEY=
WHOIS_XML_API_KEY=

SONARQUBE_TOKEN=
CORS_ORIGINS=