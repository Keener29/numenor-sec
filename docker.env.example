# Docker Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# These are automatically configured for Docker - no changes needed
DB_HOST=postgres
DB_PORT=5432
DB_NAME=numenor_security
DB_USER=numenor_user
DB_PASSWORD=numenor_password

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
API_PORT=3000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate strong secrets for production:
# JWT_SECRET: Use a long, random string (32+ characters)
# TOKEN_SECRET: Use a 64-character hex string
JWT_SECRET=your-super-secret-jwt-key-change-in-production
TOKEN_SECRET=your-64-character-hex-secret-key-change-in-production

# =============================================================================
# EMAIL CONFIGURATION (OPTIONAL FOR TESTING)
# =============================================================================
# For testing, you can use the defaults. For production, configure your SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Numenor Security <your-email@gmail.com>

# =============================================================================
# REDIS CONFIGURATION (OPTIONAL)
# =============================================================================
# These are automatically configured for Docker - no changes needed
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
# For production deployment:
# 1. Change all default passwords
# 2. Use strong, unique secrets for JWT_SECRET and TOKEN_SECRET
# 3. Configure proper SMTP settings for email functionality
# 4. Set NODE_ENV=production
# 5. Use docker-compose.prod.yml for production deployment
