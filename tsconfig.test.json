{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node", "vite/client"],
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "jest.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.test.ts",
    "app/**/*.test.tsx"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
